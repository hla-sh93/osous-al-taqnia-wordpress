<?xml version="1.0"?>
<ruleset name="Osous">
	<description>WordPress Coding Standards for the Osous theme.</description>

	<file>theme/osous</file>
	<exclude-pattern>theme/osous/assets/*</exclude-pattern>
	<exclude-pattern>theme/osous/content/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="osous"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="osous"/>
			</property>
		</properties>
	</rule>

	<!-- These helpers return markup that has been filtered through wp_kses(). -->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customAutoEscapedFunctions" type="array">
				<element value="osous_fragment"/>
				<element value="osous_kses"/>
			</property>
		</properties>
	</rule>
</ruleset>
